# Copie ce fichier en .env.local (non versionne) pour tes valeurs reelles.
# .env est deja versionne avec des valeurs par defaut non sensibles pour le dev Docker.

APP_ENV=dev
APP_SECRET=change_me

DEFAULT_URI=http://localhost:8080

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://app:change_me@database:5432/app?serverVersion=16&charset=utf8"

# Utilise a partir de l'etape 9 (envoi d'e-mails de confirmation)
# Le service mailpit du compose.yaml ecoute sur mailpit:1025, interface web sur http://localhost:8025
MAILER_DSN=smtp://mailpit:1025
MAILER_EXPEDITEUR=contact@prodigestudio.example

# Utilise si un front externe consomme l'API Platform en dehors du domaine du site
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
