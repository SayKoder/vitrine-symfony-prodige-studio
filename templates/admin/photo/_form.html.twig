{{ form_start(form, {attr: {class: 'form-grille'}}) }}
    <div class="champ">
        {{ form_label(form.categorie) }}
        {{ form_widget(form.categorie) }}
        {{ form_errors(form.categorie) }}
    </div>

    <div class="champ">
        {{ form_label(form.legende) }}
        {{ form_widget(form.legende) }}
        {{ form_errors(form.legende) }}
    </div>

    <div class="champ champ--case">
        {{ form_widget(form.misEnAvant) }}
        {{ form_label(form.misEnAvant) }}
    </div>

    {{ include('admin/_point_focal.html.twig', {
        form: form,
        image_url: (photo is defined and photo.image) ? '/uploads/photos/' ~ photo.image : null,
        apercus: [
            {label: 'Hero grand', ratio: '7 / 9'},
            {label: 'Hero petit', ratio: '10 / 11'},
            {label: 'Galerie', ratio: '1 / 1'},
            {label: 'Galerie haute', ratio: '3 / 4'},
            {label: 'Galerie large', ratio: '4 / 3'},
        ],
    }) }}

    <div class="champ champ--pleine-largeur">
        {{ form_label(form.imageFichier) }}
        {{ form_widget(form.imageFichier) }}
        {{ form_errors(form.imageFichier) }}
    </div>

    <button type="submit" class="bouton bouton--plein">Enregistrer</button>
{{ form_end(form) }}
