{% extends 'public/base.html.twig' %}

{% block title %}Photo - Back office{% endblock %}

{% block contenu %}
    <section class="section conteneur" style="padding-top: 7rem;">
        <div class="section-entete">
            <p class="label-or">Back office</p>
            <h1 class="section-titre">{{ photo.categorie.libelle }}</h1>
        </div>

        <div class="panel panel--large">
            {% if photo.image %}
                <div class="admin-image-actuelle">
                    <img src="/uploads/photos/{{ photo.image }}" alt="{{ photo.legende ?: photo.categorie.libelle }}" width="300">
                </div>
            {% endif %}

            <p class="section-note">Legende : {{ photo.legende ?: 'aucune' }}</p>
            <p class="section-note">
                Mise en avant sur la page d'accueil :
                <span class="badge {{ photo.misEnAvant ? '' : 'badge--inactif' }}">{{ photo.misEnAvant ? 'Oui' : 'Non' }}</span>
            </p>

            <div class="admin-actions">
                <a href="{{ path('admin_photo_edit', {id: photo.id}) }}" class="bouton bouton--plein">MODIFIER</a>
                <a href="{{ path('admin_photo_index') }}" class="bouton bouton--contour">RETOUR A LA GALERIE</a>
            </div>

            <form method="post" action="{{ path('admin_photo_delete', {id: photo.id}) }}" data-controller="confirmation" data-action="submit->confirmation#confirmer" data-confirmation-message-value="Supprimer cette photo ?">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-photo-' ~ photo.id) }}">
                <button type="submit" class="bouton bouton--danger">SUPPRIMER</button>
            </form>
        </div>
    </section>
{% endblock %}
