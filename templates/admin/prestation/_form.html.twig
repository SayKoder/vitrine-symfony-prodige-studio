{{ form_start(form, {attr: {class: 'form-grille'}}) }}
    <div class="champ">
        {{ form_label(form.nom) }}
        {{ form_widget(form.nom) }}
        {{ form_errors(form.nom) }}
    </div>

    <div class="champ">
        {{ form_label(form.prix) }}
        {{ form_widget(form.prix) }}
        {{ form_errors(form.prix) }}
    </div>

    <div class="champ champ--pleine-largeur">
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="champ">
        {{ form_label(form.dureeMinutes) }}
        {{ form_widget(form.dureeMinutes) }}
        {{ form_errors(form.dureeMinutes) }}
    </div>

    <div class="champ champ--case">
        {{ form_widget(form.actif) }}
        {{ form_label(form.actif) }}
    </div>

    <div class="champ champ--case">
        {{ form_widget(form.misEnAvant) }}
        {{ form_label(form.misEnAvant) }}
    </div>

    {{ include('admin/_point_focal.html.twig', {
        form: form,
        image_url: (prestation is defined and prestation.image) ? '/uploads/prestations/' ~ prestation.image : null,
        apercus: [
            {label: 'Carte forfait', ratio: '4 / 3'},
        ],
    }) }}

    <div class="champ champ--pleine-largeur">
        {{ form_label(form.imageFichier) }}
        {{ form_widget(form.imageFichier) }}
        {{ form_errors(form.imageFichier) }}
    </div>

    <button type="submit" class="bouton bouton--plein">Enregistrer</button>
{{ form_end(form) }}
