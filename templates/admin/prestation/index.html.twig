{% extends 'public/base.html.twig' %}

{% block title %}Prestations - Back office{% endblock %}

{% block contenu %}
    <section class="section conteneur" style="padding-top: 7rem;">
        <div class="section-entete">
            <p class="label-or">Back office</p>
            <h1 class="section-titre">Les <span class="accent">prestations</span></h1>
        </div>

        <div class="admin-actions">
            <a href="{{ path('admin_prestation_new') }}" class="bouton bouton--plein">NOUVELLE PRESTATION</a>
        </div>

        <p class="section-note">
            L'apercu reflete le point focal enregistre pour chaque forfait, tel qu'il apparaitra sur la carte du catalogue.
        </p>

        <div class="tableau-conteneur">
            <table class="tableau">
                <thead>
                    <tr>
                        <th>Apercu</th>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Visible</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for prestation in prestations %}
                    <tr>
                        <td>
                            {% if prestation.image %}
                                <img class="tableau-vignette" src="/uploads/prestations/{{ prestation.image }}" alt="{{ prestation.nom }}" style="object-position: {{ prestation.pointFocalX }}% {{ prestation.pointFocalY }}%">
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>{{ prestation.nom }}</td>
                        <td>{{ prestation.prix }} EUR</td>
                        <td>
                            <span class="badge {{ prestation.actif ? '' : 'badge--inactif' }}">{{ prestation.actif ? 'Oui' : 'Non' }}</span>
                        </td>
                        <td>
                            <a href="{{ path('admin_prestation_show', {id: prestation.id}) }}">Voir</a>
                            <a href="{{ path('admin_prestation_edit', {id: prestation.id}) }}">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucune prestation pour le moment.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
