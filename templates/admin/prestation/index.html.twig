{% extends 'base.html.twig' %}

{% block title %}Prestations{% endblock %}

{% block body %}
    <h1>Prestations</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    <a href="{{ path('admin_prestation_new') }}">Nouvelle prestation</a>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Visible</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for prestation in prestations %}
            <tr>
                <td>{{ prestation.nom }}</td>
                <td>{{ prestation.prix }} EUR</td>
                <td>{{ prestation.actif ? 'oui' : 'non' }}</td>
                <td>
                    <a href="{{ path('admin_prestation_show', {id: prestation.id}) }}">Voir</a>
                    <a href="{{ path('admin_prestation_edit', {id: prestation.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucune prestation pour le moment.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
