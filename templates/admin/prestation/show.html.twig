{% extends 'public/base.html.twig' %}

{% block title %}{{ prestation.nom }} - Back office{% endblock %}

{% block contenu %}
    <section class="section conteneur" style="padding-top: 7rem;">
        <div class="section-entete">
            <p class="label-or">Back office</p>
            <h1 class="section-titre">{{ prestation.nom }}</h1>
        </div>

        <div class="panel panel--large">
            {% if prestation.image %}
                <div class="admin-image-actuelle">
                    <img src="/uploads/prestations/{{ prestation.image }}" alt="{{ prestation.nom }}" width="300">
                </div>
            {% endif %}

            <p class="section-note">{{ prestation.description }}</p>
            <p class="section-note">Prix : {{ prestation.prix }} EUR</p>
            <p class="section-note">Duree : {{ prestation.dureeMinutes ?: 'non renseignee' }}</p>
            <p class="section-note">
                Visible dans le catalogue :
                <span class="badge {{ prestation.actif ? '' : 'badge--inactif' }}">{{ prestation.actif ? 'Oui' : 'Non' }}</span>
            </p>
            <p class="section-note">
                Mise en avant sur la vitrine :
                <span class="badge {{ prestation.misEnAvant ? '' : 'badge--inactif' }}">{{ prestation.misEnAvant ? 'Oui' : 'Non' }}</span>
            </p>

            <div class="admin-actions">
                <a href="{{ path('admin_prestation_edit', {id: prestation.id}) }}" class="bouton bouton--plein">MODIFIER</a>
                <a href="{{ path('admin_prestation_index') }}" class="bouton bouton--contour">RETOUR A LA LISTE</a>
            </div>

            <form method="post" action="{{ path('admin_prestation_delete', {id: prestation.id}) }}" onsubmit="return confirm('Supprimer cette prestation ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-prestation-' ~ prestation.id) }}">
                <button type="submit" class="bouton bouton--danger">SUPPRIMER</button>
            </form>
        </div>
    </section>
{% endblock %}
