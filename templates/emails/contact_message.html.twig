<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouveau message du site</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0a0908; font-family: Georgia, 'Times New Roman', serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #0a0908; padding: 2.5rem 1rem;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 32rem; background-color: #15130f; border: 1px solid rgba(199, 160, 82, 0.25); border-radius: 4px;" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="padding: 2rem 2rem 1rem; text-align: center;">
                            <p style="color: #c7a052; letter-spacing: 0.3em; font-size: 0.75rem; text-transform: uppercase; margin: 0;">Prodige Studio</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 2rem 1.5rem; text-align: center;">
                            <h1 style="color: #f2ece1; font-size: 1.4rem; font-weight: 400; margin: 0;">Nouveau message du formulaire de contact</h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 0 2rem 2rem;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top: 1px solid rgba(199, 160, 82, 0.2);">
                                <tr>
                                    <td style="padding: 0.6rem 0; color: #948c7a; font-size: 0.85rem; width: 30%;">Nom</td>
                                    <td style="padding: 0.6rem 0; color: #f2ece1; font-size: 0.9rem;">{{ contact.nom }}</td>
                                </tr>
                                <tr>
                                    <td style="padding: 0.6rem 0; color: #948c7a; font-size: 0.85rem;">E-mail</td>
                                    <td style="padding: 0.6rem 0; color: #f2ece1; font-size: 0.9rem;">{{ contact.email }}</td>
                                </tr>
                                {% if contact.telephone %}
                                    <tr>
                                        <td style="padding: 0.6rem 0; color: #948c7a; font-size: 0.85rem;">Telephone</td>
                                        <td style="padding: 0.6rem 0; color: #f2ece1; font-size: 0.9rem;">{{ contact.telephone }}</td>
                                    </tr>
                                {% endif %}
                                <tr>
                                    <td style="padding: 0.6rem 0; color: #948c7a; font-size: 0.85rem;">Sujet</td>
                                    <td style="padding: 0.6rem 0; color: #c7a052; font-size: 0.9rem;">{{ contact.sujet }}</td>
                                </tr>
                            </table>

                            <p style="color: #948c7a; font-size: 0.8rem; margin: 1.25rem 0 0.5rem;">Message</p>
                            <p style="color: #f2ece1; font-size: 0.9rem; line-height: 1.6; white-space: pre-line; margin: 0;">{{ contact.message }}</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 1.5rem 2rem 2rem; border-top: 1px solid rgba(199, 160, 82, 0.15);">
                            <p style="color: #6a6458; font-size: 0.8rem; margin: 0;">
                                Repondez directement a cet e-mail pour ecrire a {{ contact.nom }}.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
