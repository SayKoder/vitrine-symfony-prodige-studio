{% extends 'public/base.html.twig' %}

{% block title %}Connexion - Prodige Studio{% endblock %}

{% block contenu %}
    <section class="section conteneur" style="padding-top: 7rem;">
        <div class="panel">
            <p class="label-or">Espace client</p>
            <h1 class="section-titre">Se <span class="accent">connecter</span></h1>

            {% if error %}
                <div class="flash-message flash-message--erreur" style="margin-top: 1.5rem;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" class="form-grille" style="margin-top: 2rem;">
                <div class="champ champ--pleine-largeur">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
                </div>

                <div class="champ champ--pleine-largeur">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="bouton bouton--plein">Se connecter</button>
            </form>
        </div>
    </section>
{% endblock %}
